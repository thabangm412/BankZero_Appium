<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Regression" verbose="2" thread-count="1" parallel="false" preserve-order="true">
    <listeners>
        <listener class-name="utils.Listeners"/>
    </listeners>

    <test name="Device Pairing Tests">
        <classes>
            <class name="tests.DevicePair.DevicePairTests">
                <methods>
                    <include name="DevicePairTest"/>
                    <include name="DevicePairLoginTest"/>
                    <include name="DevicePairLogoutTest"/>
                    <include name="SafeModeCheckTest"/>
                    <include name="SafeModeLiftTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>