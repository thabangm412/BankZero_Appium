<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Smoke Test Pack" verbose="2" thread-count="1" parallel="false" preserve-order="true">

    <listeners>
        <listener class-name="utils.Listeners"/>
    </listeners>

    <test name="Device Pair Tests">
        <classes>
            <class name="tests.DevicePair.DevicePairTests">
                <methods>
                    <include name="DevicePairTest"/>
                    <include name="SafeModeLiftTest"/>
                </methods>
            </class>

            <class name="tests.Pay.PaymentTests">
                <methods>
                    <include name="AddRecipientTestWithPoP"/>
                    <include name="PaymentToAddedRecipientWithPoPTest"/>
                </methods>
            </class>

            <class name="tests.Pay.RtcPaymentTests">
                <methods>
                    <include name="AddRtcRecipientTestWithPoP"/>
                    <include name="RtCPaymentTest"/>
                </methods>
            </class>

            <class name="tests.SendMoney.SendMoneyTests">
                <methods>
                    <include name="addNewRecipient"/>
                    <include name="sendMoneyToNewRecipient"/>
                </methods>
            </class>

            <class name="tests.Transfer.TransferMoneyTests">
                <methods>
                    <include name="transferMoney"/>
                </methods>
            </class>

            <class name="tests.Buy.BuyAirtime.NewAirtimeAccTests">
                <methods>
                    <include name="newAirtimePurchase"/>
                </methods>
            </class>
            <class name="tests.Buy.BuyData.NewDataAccTests">
                <methods>
                    <include name="newDataAccTest"/>
                </methods>
            </class>
            <class name="tests.Buy.BuySMS.NewSMSAccTests">
                <methods>
                    <include name="newSMSAccTest"/>
                </methods>
            </class>

            <class name="tests.Buy.BuyElectricity.NewElectricityAccTest">
                <methods>
                    <include name="newElectricityAccTest"/>
                </methods>
            </class>

            <class name="tests.StatementsAndLetters.StatementsAndLettersTests">
                <methods>
                    <include name="accountConfirmationLetterEmailTest"/>
                    <include name="accountStatementsEmailTest"/>
                </methods>
            </class>

            <class name="tests.Child.ChildAccountRegistrationTest">
                <methods>
                    <include name="childInviteTest"/>
                    <include name="childRegistrationTest"/>
                    <include name="childLoginTest"/>
                </methods>
            </class>
            
            <class name="tests.Registration.GreenBookRegistrationTest">
                <methods>
                    <include name="registrationPositiveFlow"/>
                    <include name="loginTest"/>
                </methods>
            </class>

            <class name="tests.Business.Registration.BusinessPtyTest">
                <methods>
                    <include name="PtyRegistration"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>